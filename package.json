{
  "name": "quetzin-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm media:prepare && react-router dev",
    "build": "pnpm media:prepare && react-router build && node scripts/generate-seo.js && pnpm format:html && node scripts/compress-static.js && node scripts/build-vercel.js",
    "format": "prettier --write \"app/**/*.{js,jsx,json,css}\" \"scripts/**/*.js\" \"*.{js,json}\"",
    "format:check": "prettier --check \"app/**/*.{js,jsx,json,css}\" \"scripts/**/*.js\" \"*.{js,json}\"",
    "format:html": "node scripts/format-html.js",
    "preview": "node scripts/preview.js",
    "test": "pnpm media:prepare && node --test app/content/*.test.js app/motion/*.test.js scripts/*.test.js",
    "check:pages": "node scripts/check-pages.js",
    "check": "pnpm format:check && pnpm test && pnpm build && pnpm check:pages && pnpm check:links",
    "media:prepare": "node scripts/prepare-media.js",
    "check:links": "node scripts/check-links.js",
    "perf": "node scripts/performance.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-router/node": "^7.9.0",
    "@react-router/serve": "^7.9.0",
    "gsap": "^3.13.0",
    "isbot": "^5",
    "lenis": "^1.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.0",
    "lighthouse": "^13.6.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "sirv": "^3.0.2",
    "sirv-cli": "^3.0.1",
    "vite": "^7.1.0"
  }
}
